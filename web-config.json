{
    "compilerOptions": {
        "declaration": false,
        "declarationMap": false,
        "esModuleInterop": true,
        "incremental": true,
        "isolatedModules": true,
        "lib": [
            "dom",
            "dom.iterable",
            "es2022"
        ],
        "module": "esnext",
        "moduleDetection": "force",
        "moduleResolution": "bundler",
        "noUncheckedIndexedAccess": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "strict": true,
        "target": "es2022",
        "plugins": [
            {
                "name": "next"
            }
        ],
        "jsx": "preserve",
        "noEmit": true,
        "allowJs": true,
        "checkJs": true,
        "ignoreDeprecations": "6.0",
        "baseUrl": "./",
        "paths": {
            "~/*": [
                "./*"
            ]
        },
        "allowSyntheticDefaultImports": true,
        "resolvePackageJsonExports": true,
        "resolvePackageJsonImports": true,
        "preserveConstEnums": true,
        "useDefineForClassFields": true,
        "noImplicitAny": true,
        "noImplicitThis": true,
        "strictNullChecks": true,
        "strictFunctionTypes": true,
        "strictBindCallApply": true,
        "strictPropertyInitialization": true,
        "strictBuiltinIteratorReturn": true,
        "alwaysStrict": true,
        "useUnknownInCatchVariables": true
    },
    "files": [
        "./global.d.ts",
        "./next-env.d.ts",
        "./app/component/architecture/architecture-data.ts",
        "./app/component/contact/contact-data.ts",
        "./app/component/hero/hero-data.ts",
        "./app/component/journey/journey-data.ts",
        "./app/constants/journey.ts",
        "./app/constants/projects.ts",
        "./hooks/use-mobile.ts",
        "./lib/utils.ts",
        "./lib/visitor.ts",
        "./trpc/client.ts",
        "./trpc/create-client.ts",
        "./trpc/server.ts",
        "./app/Visitor.tsx",
        "./app/layout.tsx",
        "./app/page.tsx",
        "./app/component/architecture/ArchitectureNode.tsx",
        "./app/component/architecture/ArchitectureTree.tsx",
        "./app/component/background/SchematicBackground.tsx",
        "./app/component/contact/ContactChannel.tsx",
        "./app/component/contact/ContactTerminal.tsx",
        "./app/component/contact/CornerBracket.tsx",
        "./app/component/guestbook/GuestbookEntry.tsx",
        "./app/component/guestbook/GuestbookForm.tsx",
        "./app/component/hero/CornerBracket.tsx",
        "./app/component/hero/SystemMetrics.tsx",
        "./app/component/journey/JourneyCard.tsx",
        "./app/component/layout/Footer.tsx",
        "./app/component/layout/Navbar.tsx",
        "./app/component/project/ProjectCard.tsx",
        "./app/component/project/ProjectReactions.tsx",
        "./app/component/sections/ContactSection.tsx",
        "./app/component/sections/GuestbookSection.tsx",
        "./app/component/sections/HeroSection.tsx",
        "./app/component/sections/JourneySection.tsx",
        "./app/component/sections/ProjectsSection.tsx",
        "./components/ui_backup/accordion.tsx",
        "./components/ui_backup/alert-dialog.tsx",
        "./components/ui_backup/alert.tsx",
        "./components/ui_backup/aspect-ratio.tsx",
        "./components/ui_backup/avatar.tsx",
        "./components/ui_backup/badge.tsx",
        "./components/ui_backup/breadcrumb.tsx",
        "./components/ui_backup/button-group.tsx",
        "./components/ui_backup/button.tsx",
        "./components/ui_backup/calendar.tsx",
        "./components/ui_backup/card.tsx",
        "./components/ui_backup/carousel.tsx",
        "./components/ui_backup/chart.tsx",
        "./components/ui_backup/checkbox.tsx",
        "./components/ui_backup/collapsible.tsx",
        "./components/ui_backup/command.tsx",
        "./components/ui_backup/context-menu.tsx",
        "./components/ui_backup/dialog.tsx",
        "./components/ui_backup/drawer.tsx",
        "./components/ui_backup/dropdown-menu.tsx",
        "./components/ui_backup/empty.tsx",
        "./components/ui_backup/field.tsx",
        "./components/ui_backup/form.tsx",
        "./components/ui_backup/hover-card.tsx",
        "./components/ui_backup/input-group.tsx",
        "./components/ui_backup/input-otp.tsx",
        "./components/ui_backup/input.tsx",
